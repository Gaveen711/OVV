# Media files
# The 4K master stays local; only the web-ready hero encodes are committed,
# otherwise Vercel (which deploys from git) ships a site with no hero video.
# Screenshots from scripts/capture-scroll.mjs - regenerate, don't commit
scroll-capture/

media-source/
public/images/hero-poster.jpg
*.mp4
*.webm

# ...with the single exception of the encode the hero actually loads. Listed by
# name rather than un-ignoring public/videos/, so a fresh 4K master or a stray
# export dropped in that folder still stays out of the repo.
!public/videos/ovv-hero-1080p.mp4
!public/videos/ovv-hero-720p.mp4
.vercel

.vercel
.env*
